{
  "agent_buffer_font_size": 15.0,
  "agent_ui_font_size": 15.0,
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "diff_view_style": "split",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    },
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "disable_ai": false,
  "languages": {
    "Python": {
      "language_servers": [
        "ty",
        "ruff",
        "!basedpyright",
        "!pyright"
      ]
    }
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "runnables": false,
    "breakpoints": false,
    "folds": false,
    "line_numbers": true,
    "min_line_number_digits": 4
  },
  "ui_font_family": "Noto Sans",
  "buffer_font_family": "IosevkaTerm Nerd Font Mono",
  "vim_mode": true,
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "show_edit_predictions": false,
  "markdown_preview": {
    "code_font_family": "IosevkaTerm Nerd Font Mono",
    "max_width": 1000,
  }
}
